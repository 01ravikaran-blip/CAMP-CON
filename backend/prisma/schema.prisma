generator client {
  provider = "prisma-client-js"
  output   = "../../apps/web/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum ListingStatus {
  ACTIVE
  IN_ESCROW
  SOLD
  CANCELLED
}

enum PaymentType {
  UPI_INR
  IN_APP_POINTS
}

enum EscrowStatus {
  HELD
  RELEASED
  REFUNDED
  DISPUTED
}

model User {
  id                String            @id @default(uuid())
  tenantId          String            // Campus Institution ID
  username          String            @unique
  fullName          String
  avatarUrl         String?
  isVerified        Boolean           @default(false)
  isPremium         Boolean           @default(false)
  
  // Gamification & Energy
  energy            Int               @default(100)
  maxEnergy         Int               @default(100)
  popularityScore   Int               @default(0)
  lastEnergyRefill  DateTime          @default(now())
  freeMessageCount  Int               @default(1) // Refreshed monthly
  points            Int               @default(0) // In-App Escrow Points
  
  // Relations
  sentRequests      ConnectionRequest[] @relation("SentRequests")
  receivedRequests  ConnectionRequest[] @relation("ReceivedRequests")
  sentMessages      DirectMessage[]
  eventCheckIns     EventAttendance[]
  listings          MarketplaceListing[]
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model ConnectionRequest {
  id                String            @id @default(uuid())
  tenantId          String
  requesterId       String
  targetId          String
  status            ConnectionStatus  @default(PENDING)
  energySpent       Int
  penaltyMultiplier Float             @default(1.0)
  
  // Reciprocity & 48-Hour Chat Lock
  chatExpiresAt     DateTime?
  requesterMsgCount Int               @default(0)
  targetMsgCount    Int               @default(0)
  isPermanent       Boolean           @default(false)
  
  requester         User              @relation("SentRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  target            User              @relation("ReceivedRequests", fields: [targetId], references: [id], onDelete: Cascade)
  messages          DirectMessage[]
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([requesterId, targetId])
  @@index([tenantId, status])
}

model DirectMessage {
  id                String            @id @default(uuid())
  connectionId      String
  senderId          String
  content           String
  isRequestPitch    Boolean           @default(false)
  createdAt         DateTime          @default(now())
  
  connection        ConnectionRequest @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  sender            User              @relation(fields: [senderId], references: [id])
}

model CampusEvent {
  id                String            @id @default(uuid())
  tenantId          String
  title             String
  description       String
  locationName      String
  latitude          Float
  longitude         Float
  radiusMeters      Float             @default(25.0)
  energyReward      Int               @default(50)
  qrSecret          String            // Secret seed to generate rotating 15s OTP tokens
  startTime         DateTime
  endTime           DateTime
  
  attendances       EventAttendance[]
}

model EventAttendance {
  id                String            @id @default(uuid())
  userId            String
  eventId           String
  energyAwarded     Int
  checkedInAt       DateTime          @default(now())
  
  user              User              @relation(fields: [userId], references: [id])
  event             CampusEvent       @relation(fields: [eventId], references: [id])

  @@unique([userId, eventId])
}

model MarketplaceListing {
  id            String         @id @default(uuid())
  tenantId      String
  sellerId      String
  title         String
  description   String
  category      String         // "Books", "Bikes", "Electronics", "Hostel Gear", "Services"
  priceINR      Float?
  pricePoints   Int?
  images        String[]
  status        ListingStatus  @default(ACTIVE)
  
  seller        User           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([tenantId, category, status])
}

model Transaction {
  id            String         @id @default(uuid())
  tenantId      String
  listingId     String
  buyerId       String
  sellerId      String
  amount        Float
  paymentType   PaymentType
  escrowStatus  EscrowStatus   @default(HELD)
  upiRefNumber  String?
  rating        Int?
  review        String?
  
  listing       MarketplaceListing @relation(fields: [listingId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

