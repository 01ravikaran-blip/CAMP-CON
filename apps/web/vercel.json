{
  "crons": [
    {
      "path": "/api/social/crons/expire-requests",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/social/crons/monthly-reset",
      "schedule": "0 0 1 * *"
    }
  ],
  "headers": [
    {
      "source": "/api/realtime",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-transform"
        },
        {
          "key": "Connection",
          "value": "keep-alive"
        }
      ]
    }
  ]
}
